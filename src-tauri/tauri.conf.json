{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "大布象棋",
  "version": "1.0.0",
  "identifier": "com.dabu.xiangqi",
  "build": {
    "frontendDist": "../web-dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "大布象棋",
        "width": 1000,
        "height": 760,
        "minWidth": 720,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "backgroundColor": "#fdf6f2"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
